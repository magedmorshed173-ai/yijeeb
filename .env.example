# ============================================================
# يجيب — مرجع إعدادات الخادم
# ملاحظة: الخادم لا يقرأ ملف .env تلقائيًا — استخدم هذه القيم
# مع Docker Compose (يقرأ .env تلقائيًا) أو صدّرها في الصدفة:
#   export $(grep -v '^#' .env | xargs)
# ============================================================

# منفذ الخادم (افتراضي 3000)
PORT=3000

# مجلد البيانات: قاعدة بيانات SQLite + المرفقات + مفاتيح الإشعارات
# في Render مع قرص دائم: /var/data        في Docker: /data
# DATA_DIR=/data

# سر توقيع الجلسات — إلزامي في الإنتاج. ولّد واحدًا:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ملاحظة: مُشغّلات يجيب (scripts/start.sh و start.ps1) تولّده وتحفظه تلقائيًا
# JWT_SECRET=

# مفاتيح Web Push (اختياري — تُولَّد وتُحفظ تلقائيًا أول إقلاع)
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:chatyijeeb@gmail.com

# مفتاح وصول لإحصاءات /api/stats?key=... (اختياري)
# STATS_KEY=

# تطبيق أندرويد (TWA من PWABuilder) — يخفي شريط العنوان
# TWA_PACKAGE=app.yijeeb.twa
# TWA_SHA256=

# الإنتاج: يفعّل HSTS ويُلزم بوجود JWT_SECRET
# NODE_ENV=production
